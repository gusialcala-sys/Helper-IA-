<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Helper IA - Asistente por Voz, Navegación A-Z & Web</title>
  <style>
    /* RESET & ESTILOS BASE */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    }
    body {
      background-color: #0b0f19;
      color: #f1f5f9;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* CABECERA */
    header {
      background: rgba(15, 23, 42, 0.95);
      border-bottom: 1px solid #334155;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #6366f1, #a855f7);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: justify;
      font-weight: bold;
      font-size: 20px;
      box-shadow: 0 0 15px rgba(99, 102, 241, 0.4);
      justify-content: center;
    }
    .brand-title {
      font-size: 20px;
      font-weight: 700;
      background: linear-gradient(to right, #818cf8, #c084fc);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .badge {
      background: #1e1b4b;
      color: #818cf8;
      border: 1px solid #4338ca;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      margin-left: 8px;
    }

    /* PESTAÑAS */
    .tabs {
      display: flex;
      gap: 8px;
      background: #1e293b;
      padding: 4px;
      border-radius: 10px;
      border: 1px solid #334155;
    }
    .tab-btn {
      background: transparent;
      border: none;
      color: #94a3b8;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: #3b82f6;
      color: #ffffff;
      box-shadow: 0 0 10px rgba(59, 130, 246, 0.4);
    }

    /* CONTENEDOR PRINCIPAL */
    main {
      flex: 1;
      max-width: 1000px;
      width: 100%;
      margin: 20px auto;
      padding: 0 16px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    /* CHIPS DE SUGERENCIAS */
    .chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 10px;
    }
    .chip {
      background: #1e293b;
      border: 1px solid #334155;
      color: #cbd5e1;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .chip:hover {
      background: #334155;
      border-color: #6366f1;
      color: #fff;
    }

    /* TARJETA DEL CHAT */
    .chat-card {
      background: #151d30;
      border: 1px solid #2a3854;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      height: 520px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      overflow: hidden;
    }
    .chat-messages {
      flex: 1;
      padding: 20px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    
    .msg {
      display: flex;
      gap: 12px;
      max-width: 85%;
      animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .msg.user {
      align-self: flex-end;
      flex-direction: row-reverse;
    }
    .msg.ia {
      align-self: flex-start;
    }
    
    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      flex-shrink: 0;
    }
    .msg.ia .avatar { background: #4f46e5; color: #fff; }
    .msg.user .avatar { background: #0284c7; color: #fff; }

    .bubble {
      background: #1e293b;
      padding: 12px 16px;
      border-radius: 14px;
      border: 1px solid #334155;
      font-size: 14px;
      line-height: 1.5;
      color: #e2e8f0;
    }
    .msg.user .bubble {
      background: #2563eb;
      border-color: #3b82f6;
      color: #fff;
    }

    /* RESULT CARD DENTRO DEL CHAT */
    .link-card {
      margin-top: 10px;
      background: #0f172a;
      border: 1px solid #3b82f6;
      border-radius: 10px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .link-title { font-weight: 700; color: #60a5fa; font-size: 15px; }
    .link-url { font-size: 12px; color: #94a3b8; word-break: break-all; }
    .link-actions { display: flex; gap: 8px; margin-top: 6px; }
    .btn-action {
      background: #2563eb;
      color: white;
      text-decoration: none;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .btn-action:hover { background: #1d4ed8; }

    /* CONTROLES ENTRADA CHAT */
    .chat-controls {
      background: #0f172a;
      padding: 16px;
      border-top: 1px solid #2a3854;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .input-box {
      flex: 1;
      background: #1e293b;
      border: 1px solid #334155;
      color: #fff;
      padding: 12px 16px;
      border-radius: 10px;
      font-size: 14px;
      outline: none;
    }
    .input-box:focus {
      border-color: #6366f1;
      box-shadow: 0 0 8px rgba(99, 102, 241, 0.3);
    }
    
    .btn-mic {
      background: #dc2626;
      color: white;
      border: none;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      transition: background 0.2s;
    }
    .btn-mic.recording {
      background: #ef4444;
      animation: pulse 1s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    
    .btn-send {
      background: #4f46e5;
      color: white;
      border: none;
      padding: 0 20px;
      height: 44px;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-send:hover { background: #4338ca; }

    /* PESTAÑA PUBLICACIÓN Y EXECUTABLES */
    .deploy-panel {
      background: #151d30;
      border: 1px solid #2a3854;
      border-radius: 16px;
      padding: 24px;
      display: none;
      flex-direction: column;
      gap: 20px;
    }
    .panel-title {
      font-size: 18px;
      font-weight: 700;
      color: #38bdf8;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .step-card {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 16px;
      margin-top: 10px;
    }
    .step-num {
      display: inline-block;
      background: #0284c7;
      color: white;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      text-align: center;
      font-size: 12px;
      font-weight: bold;
      line-height: 22px;
      margin-right: 8px;
    }
    code {
      background: #1e293b;
      color: #f43f5e;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: monospace;
      font-size: 13px;
    }
  </style>
</head>
<body>

  <header>
    <div class="brand">
      <div class="logo-icon">🤖</div>
      <div>
        <span class="brand-title">HELPER IA</span>
        <span class="badge">BETA v3.5</span>
      </div>
    </div>

    <div class="tabs">
      <button class="tab-btn active" id="tab-chat-btn" onclick="switchTab('chat')">💬 Asistente IA</button>
      <button class="tab-btn" id="tab-deploy-btn" onclick="switchTab('deploy')">🚀 Publicar en Google / .EXE</button>
    </div>
  </header>

  <main>

    <!-- PANEL DEL CHAT INTERACTIVO -->
    <div id="panel-chat">
      <div class="chips">
        <div class="chip" onclick="quickSearch('llévame a esta canción que empieza por Y')">🎵 Canción con la letra Y</div>
        <div class="chip" onclick="quickSearch('llévame a esta página que empieza por G')">🌐 Página con la letra G</div>
        <div class="chip" onclick="quickSearch('dónde está la canción Yesterday')">🎼 Buscar "Yesterday"</div>
        <div class="chip" onclick="quickSearch('páginas de inteligencia artificial')">🤖 Herramientas IA</div>
      </div>

      <div class="chat-card">
        <div class="chat-messages" id="chatHistory">
          <div class="msg ia">
            <div class="avatar">IA</div>
            <div class="bubble">
              ¡Hola! Soy <b>Helper IA Beta</b>.<br><br>Puedes decirme o escribirme cosas como:<br>
              • <i>"Llévame a esta canción que empieza por Y"</i><br>
              • <i>"Página que empieza por la letra G"</i><br>
              • <i>"Dónde está la canción Yellow de Coldplay"</i><br><br>
              ¡Incluso puedes presionar el icono de micrófono 🎤 para hablarme por voz!
            </div>
          </div>
        </div>

        <div class="chat-controls">
          <button class="btn-mic" id="micBtn" onclick="toggleMic()" title="Dictar por voz">🎤</button>
          <input type="text" id="userInput" class="input-box" placeholder="Escribe 'llévame a esta canción...' o habla por voz..." onkeypress="handleKeyPress(event)">
          <button class="btn-send" onclick="sendMessage()">Enviar</button>
        </div>
      </div>
    </div>

    <!-- PANEL DE PUBLICACIÓN EN GOOGLE Y DESCARGAS -->
    <div id="panel-deploy" class="deploy-panel">
      <div class="panel-title">🌐 Cómo publicar Helper IA en Google (GitHub Pages)</div>
      <p style="color: #94a3b8; font-size: 14px;">Sigue estos pasos para tener tu propia dirección URL pública accesible desde cualquier navegador:</p>

      <div class="step-card">
        <p style="margin-bottom: 8px;"><span class="step-num">1</span><b>Crea un repositorio en GitHub:</b> Entra en <a href="https://github.com" target="_blank" style="color: #38bdf8;">GitHub.com</a> y crea un proyecto nuevo llamado <code>helper-ia</code>.</p>
        <p style="margin-bottom: 8px;"><span class="step-num">2</span><b>Sube el archivo:</b> Guarda este código como <code>index.html</code> y súbelo al repositorio.</p>
        <p style="margin-bottom: 8px;"><span class="step-num">3</span><b>Activa GitHub Pages:</b> Ve a <b>Settings ➔ Pages</b> en tu repositorio, selecciona la rama <code>main</code> y haz clic en <b>Save</b>.</p>
        <p><span class="step-num">4</span><b>¡Listo!</b> Tu sitio estará publicado en un enlace similar a: <code>https://tu-usuario.github.io/helper-ia/</code>.</p>
      </div>

      <div class="panel-title" style="margin-top: 15px; color: #c084fc;">💻 Compilar Ejecutable de Escritorio (.EXE / .DMG)</div>
      <p style="color: #94a3b8; font-size: 14px;">Para convertirlo en un archivo ejecutable nativo para Windows o Mac usando Electron.js, ejecuta en tu terminal:</p>

      <div class="step-card">
        <p style="margin-bottom: 6px;"><code>npm install</code></p>
        <p style="margin-bottom: 6px;"><code>npm run dist</code></p>
        <p style="color: #a7f3d0; font-size: 13px; margin-top: 10px;">✔ Se generará automáticamente un ejecutable <b>.exe</b> para Windows en la carpeta <code>/dist/</code>.</p>
      </div>
    </div>

  </main>

  <script>
    // BASE DE DATOS DE CANCIONES Y PÁGINAS A-Z
    const database = {
      songs: {
        'A': { name: "Adèle - Hello", url: "https://www.youtube.com/results?search_query=adele+hello" },
        'B': { name: "Bohemian Rhapsody - Queen", url: "https://www.youtube.com/results?search_query=bohemian+rhapsody" },
        'C': { name: "Coldplay - Clocks", url: "https://www.youtube.com/results?search_query=coldplay+clocks" },
        'D': { name: "Dua Lipa - Dance The Night", url: "https://www.youtube.com/results?search_query=dua+lipa+dance+the+night" },
        'E': { name: "Eminem - Lose Yourself", url: "https://www.youtube.com/results?search_query=eminem+lose+yourself" },
        'F': { name: "Fleetwood Mac - Dreams", url: "https://www.youtube.com/results?search_query=fleetwood+mac+dreams" },
        'G': { name: "Gorillaz - Feel Good Inc.", url: "https://www.youtube.com/results?search_query=gorillaz+feel+good+inc" },
        'H': { name: "Hotel California - Eagles", url: "https://www.youtube.com/results?search_query=hotel+california+eagles" },
        'Y': { name: "Yesterday - The Beatles", url: "https://www.youtube.com/results?search_query=yesterday+the+beatles" }
      },
      websites: {
        'G': { name: "Google Search", url: "https://www.google.com" },
        'Y': { name: "YouTube", url: "https://www.youtube.com" },
        'GITH': { name: "GitHub", url: "https://github.com" },
        'W': { name: "Wikipedia", url: "https://es.wikipedia.org" }
      }
    };

    let isRecording = false;
    let recognition = null;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.lang = 'es-ES';
      recognition.continuous = false;

      recognition.onresult = (event) => {
        const text = event.results[0][0].transcript;
        document.getElementById('userInput').value = text;
        toggleMic();
        sendMessage();
      };

      recognition.onerror = () => toggleMic();
    }

    function toggleMic() {
      const btn = document.getElementById('micBtn');
      if (!recognition) {
        alert("Tu navegador no soporta reconocimiento de voz nativo.");
        return;
      }
      if (!isRecording) {
        recognition.start();
        isRecording = true;
        btn.classList.add('recording');
      } else {
        recognition.stop();
        isRecording = false;
        btn.classList.remove('recording');
      }
    }

    function switchTab(tab) {
      document.getElementById('tab-chat-btn').classList.toggle('active', tab === 'chat');
      document.getElementById('tab-deploy-btn').classList.toggle('active', tab === 'deploy');
      document.getElementById('panel-chat').style.display = tab === 'chat' ? 'block' : 'none';
      document.getElementById('panel-deploy').style.display = tab === 'deploy' ? 'flex' : 'none';
    }

    function handleKeyPress(e) {
      if (e.key === 'Enter') sendMessage();
    }

    function quickSearch(text) {
      document.getElementById('userInput').value = text;
      sendMessage();
    }

    function sendMessage() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      if (!text) return;

      addMessage(text, 'user');
      input.value = '';

      setTimeout(() => {
        processQuery(text);
      }, 400);
    }

    function addMessage(text, sender, linkData = null) {
      const chatHistory = document.getElementById('chatHistory');
      const msgDiv = document.createElement('div');
      msgDiv.className = `msg ${sender}`;

      const avatar = document.createElement('div');
      avatar.className = 'avatar';
      avatar.innerText = sender === 'ia' ? 'IA' : 'Tú';

      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.innerHTML = text;

      if (linkData) {
        const linkCard = document.createElement('div');
        linkCard.className = 'link-card';
        linkCard.innerHTML = `
          <div class="link-title">🔗 ${linkData.name}</div>
          <div class="link-url">${linkData.url}</div>
          <div class="link-actions">
            <a href="${linkData.url}" target="_blank" class="btn-action">🚀 Ir a la página</a>
          </div>
        `;
        bubble.appendChild(linkCard);
      }

      msgDiv.appendChild(avatar);
      msgDiv.appendChild(bubble);
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;

      // Lectura por voz de la respuesta de la IA
      if (sender === 'ia' && 'speechSynthesis' in window) {
        const cleanText = text.replace(/<[^>]*>?/gm, '');
        const utterance = new SpeechSynthesisUtterance(cleanText);
        utterance.lang = 'es-ES';
        window.speechSynthesis.speak(utterance);
      }
    }

    function processQuery(query) {
      const q = query.toLowerCase();

      // Detección de letra aislada
      let matchLetter = null;
      const letterMatch = q.match(/letra\s+([a-z])/i) || q.match(/\bpor\s+([a-z])\b/i) || q.match(/\b([a-z])\b$/i);
      if (letterMatch) {
        matchLetter = letterMatch[1].toUpperCase();
      }

      if (q.includes('canción') || q.includes('cancion') || q.includes('música') || q.includes('musica')) {
        const letter = matchLetter || 'Y';
        const song = database.songs[letter] || { name: `Canción con la letra ${letter}`, url: `https://www.youtube.com/results?search_query=cancion+letra+${letter}` };
        
        addMessage(`He decodificado tu petición. Aquí tienes la canción asociada a la letra **${letter}**:`, 'ia', song);
      } else if (q.includes('página') || q.includes('pagina') || q.includes('web') || q.includes('sitio')) {
        const letter = matchLetter || 'G';
        const site = database.websites[letter] || { name: `Búsqueda Web para ${letter}`, url: `https://www.google.com/search?q=${letter}` };
        
        addMessage(`He encontrado el enlace directo para la página web con la letra **${letter}**:`, 'ia', site);
      } else {
        // Búsqueda genérica
        const genericLink = { name: `Búsqueda en la web: "${query}"`, url: `https://www.google.com/search?q=${encodeURIComponent(query)}` };
        addMessage(`Procesé tu orden: *"<sup>${query}</sup>"*. Puedes acceder directamente aquí:`, 'ia', genericLink);
      }
    }
  </script>
</body>
</html>
